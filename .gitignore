# 依赖与构建产物
.pnpm-store
node_modules/
dist/
releases/

# 草稿区（每次重来的东西：pack 组装台 .tmp/pkg、测试产物、调试输出）
.tmp/

# 缓存区（带键、可复用、可校验的中间产物，跨 run 复用）：
#   .cache/dsh-build/<键>/   T1 包集（dist-npm + build-recipe.json + 清单 + 交付锁）
#   .cache/pkg-root/<键>/    物化节点（全叉乘超集，各目标剪枝；recipe 判命中）
#   .cache/integrations*/    集成 stage / build 产物
.cache/

# 系统杂项
*.log
.DS_Store

# SDD 本地 spec（不进 git，仅本地规划产物）
SPECS.md
specs/

data/

# 运行期 node 代理（installDepsFromPlugin 写入插件根，每次安装幂等重建；不进 git）
# /node 为 Linux/macOS 无扩展名形态；仓库根无同名资产，安全忽略
/node.cmd
/node


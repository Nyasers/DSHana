{
  "name": "dshana",
  "version": "1.0.0+dsh-0.2.0-rc.2",
  "private": true,
  "packageManager": "pnpm@11.7.0+sha512.19cc852c120c7125760f2443ee6be0ca5b40f9f50598de1a09a1f177503e010e57c23c77646e01e761de59bf874fb22a3398c33ab9691fc13eb946b6f0f4d620",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || ^26.8.1"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm run verify:integrations && pnpm run verify:bundle && pnpm run check:type && pnpm run build:ui && pnpm run build:app && pnpm run build:cordis && pnpm run build:bundle && pnpm run build:integrations",
    "build:ui": "node packages/ui/src/build.ts",
    "build:app": "node packages/app/src/build.ts",
    "build:cordis": "node packages/app/src/cordis.ts",
    "build:bundle": "node packages/bundle/dsh-app/build.ts",
    "build:integrations": "node scripts/integrations/index.mts build",
    "verify:integrations": "node scripts/integrations/index.mts verify",
    "verify:bundle": "node scripts/check/bundle.mts",
    "check:type": "node scripts/check/type.mts",
    "check:engines": "node scripts/check/engines.cjs",
    "test": "node --test tests/",
    "derive": "node scripts/derive/index.mts",
    "derive:check": "node scripts/derive/index.mts --check",
    "derive:cordis": "node scripts/derive/index.mts cordis",
    "derive:paths": "node scripts/derive/index.mts paths",
    "derive:vendor": "node scripts/derive/index.mts vendor",
    "derive:manifest": "node scripts/derive/index.mts manifest",
    "derive:thirdparty": "node scripts/derive/index.mts thirdparty",
    "sync": "pnpm run sync:vendor",
    "postsync": "pnpm run derive",
    "sync:vendor": "pnpm run sync:vendor:sdk && pnpm run sync:vendor:dsh",
    "sync:vendor:sdk": "node scripts/vendor/sdk.mts",
    "postsync:vendor:sdk": "pnpm install",
    "sync:vendor:dsh": "node scripts/vendor/dsh.mts",
    "changelog": "node scripts/release/changelog.mts",
    "facts:record": "node scripts/release/package-facts.mts",
    "prepackage": "pnpm run derive && pnpm run build",
    "package": "node scripts/release/pack/index.mts",
    "postpackage": "node scripts/release/clean-cache.mts",
    "install:local": "node scripts/dev/install-local.mts",
    "probe:host": "node scripts/probe/host-surface.mts",
    "smoke:packed": "node tests/e2e/runtime-boot.smoke.mjs --packed",
    "index": "node scripts/release/market-index.mts",
    "package:linux:x64": "pnpm run package --target=linux-x64",
    "package:linux:arm64": "pnpm run package --target=linux-arm64",
    "package:mac:x64": "pnpm run package --target=darwin-x64",
    "package:mac:arm64": "pnpm run package --target=darwin-arm64",
    "package:win:x64": "pnpm run package --target=win32-x64",
    "package:win:arm64": "pnpm run package --target=win32-arm64",
    "package:universal": "pnpm run package --target=universal",
    "preversion": "pnpm run build",
    "version": "node scripts/release/version.mts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-open-in-app": "0.2.0-rc.2",
    "@dshana/app": "workspace:*",
    "@dshana/host": "workspace:*",
    "@dshana/models": "workspace:*",
    "@dshana/runtime": "workspace:*",
    "@dshana/session": "workspace:*",
    "@dshana/shared": "workspace:*",
    "@dshana/tools": "workspace:*",
    "@dshana/ui": "workspace:*",
    "@hana/app-sdk": "file:vendor/hana-app-sdk/hana-app-sdk.tgz",
    "@hana/plugin-components": "file:vendor/hana-app-sdk/hana-plugin-components-0.0.0.tgz",
    "@hana/plugin-protocol": "file:vendor/hana-app-sdk/hana-plugin-protocol-0.0.0.tgz",
    "@hana/plugin-sdk": "file:vendor/hana-app-sdk/hana-plugin-sdk-0.0.0.tgz",
    "@rspack/core": "^2.2.8",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/archiver": "^8.0.0",
    "@types/clean-css": "^4.2.11",
    "@types/fs-extra": "^11.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "archiver": "^8.0.0",
    "clean-css": "^5.3.3",
    "clsx": "^2.1.1",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "corepack": "0.36.0",
    "fs-extra": "^11.4.1",
    "html-minifier-terser": "^7.2.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "terser": "^5.51.2",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}

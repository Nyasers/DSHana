{
  "name": "@dshana/dsh-theme",
  "version": "1.0.4+dsh-0.2.0-rc.2",
  "description": "Applies Hana's host theme colors to the embedded DSH web UI.",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "cordis": {
    "name": "@dshana/dsh-theme"
  }
}
